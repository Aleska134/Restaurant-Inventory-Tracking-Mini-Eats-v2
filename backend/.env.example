# PostgreSQL connection string. Local Postgres, Neon, Supabase, or Railway all work.
# Neon example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/barmade?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barmade"

# API server port
PORT=4000

# CORS: comma-separated origins allowed to call the API (the manager + customer frontends)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- OpenRouter (end-of-day AI summary only) ---
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Free model. Fallbacks are tried in order if one is unavailable.
OPENROUTER_MODEL="nvidia/nemotron-nano-9b-v2:free"
OPENROUTER_FALLBACK_MODELS="meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free"
